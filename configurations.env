# ============================================================
# Stock Analyst Tool — Configuration
# ============================================================
# Copy this file to .env or export vars in your shell.
# Every setting has a default; override only what you need.
# ============================================================


# ------------------------------------------------------------
# MCP Server
# ------------------------------------------------------------

# MCP transport protocol
# Options: stdio | streamable-http
SA_MCP_TRANSPORT=stdio

# Port for streamable-http transport (ignored for stdio)
SA_MCP_PORT=3001


# ------------------------------------------------------------
# Data Provider
# ------------------------------------------------------------

# Primary data source for stock data
# Options: yfinance
# "yfinance" = yfinance Python library (works everywhere)
SA_DATA_PROVIDER=yfinance

# Default stock exchange suffix
# Options: .NS (NSE) | .BO (BSE)
SA_DEFAULT_EXCHANGE=.NS

# Historical data period for technical analysis
# Options: 1d | 5d | 1mo | 3mo | 6mo | 1y | 2y | 5y | 10y | ytd | max
SA_DEFAULT_PERIOD=1y

# Historical data interval
# Options: 1d | 5d | 1wk | 1mo | 3mo
SA_DEFAULT_INTERVAL=1d


# ------------------------------------------------------------
# Cache
# ------------------------------------------------------------

# Cache backend
# Options: redis | csv | none
# "redis" = Redis (must be running); falls back to csv if unavailable
# "csv"   = CSV/JSON files on disk
# "none"  = no caching, always fetch fresh
SA_CACHE_BACKEND=redis

# Redis connection URL
SA_REDIS_URL=redis://localhost:6379/0

# Cache time-to-live in seconds
# Default: 3600 (1 hour)
SA_CACHE_TTL=3600

# Directory for CSV/JSON file cache (used when redis unavailable or backend=csv)
# Supports ~ for home directory
SA_CSV_CACHE_DIR=~/.stock_analyst/cache


# ------------------------------------------------------------
# Screener.in (Peer Analysis)
# ------------------------------------------------------------

# Enable screener.in scraping for peer comparison
# Options: true | false
# Best-effort: if blocked or unreachable, skips gracefully
SA_SCREENER_ENABLED=true

# Screener.in base URL
SA_SCREENER_BASE_URL=https://www.screener.in/company

# Delay between screener.in requests (seconds) to avoid rate limiting
SA_SCREENER_DELAY=2.0

# Request timeout for screener.in (seconds)
SA_SCREENER_TIMEOUT=15


# ------------------------------------------------------------
# Output
# ------------------------------------------------------------

# Default output format
# Options: json | markdown
SA_OUTPUT_FORMAT=json

# Include raw financial data in output (large)
# Options: true | false
SA_OUTPUT_INCLUDE_RAW=false

# Pretty-print JSON output
# Options: true | false
SA_OUTPUT_PRETTY=true


# ------------------------------------------------------------
# Technical Analysis
# ------------------------------------------------------------

# EMA periods (comma-separated)
SA_TA_EMA_PERIODS=20,50,200

# RSI period
SA_TA_RSI_PERIOD=14

# MACD parameters: fast,slow,signal
SA_TA_MACD_PARAMS=12,26,9

# Enable Bollinger Bands
# Options: true | false
SA_TA_BOLLINGER_ENABLED=true

# Bollinger Bands period
SA_TA_BOLLINGER_PERIOD=20


# ------------------------------------------------------------
# Financial Analysis (financial-analyst skill integration)
# ------------------------------------------------------------

# Path to financial-analyst skill scripts
SA_FA_SCRIPTS_DIR=~/.codeium/windsurf/skills/financial-analyst/scripts

# Enable DCF valuation
# Options: true | false
SA_FA_DCF_ENABLED=true

# DCF projection years
SA_FA_DCF_PROJECTION_YEARS=5

# DCF terminal growth rate (decimal)
SA_FA_DCF_TERMINAL_GROWTH=0.025

# DCF exit EV/EBITDA multiple
SA_FA_DCF_EXIT_MULTIPLE=12.0

# WACC — risk-free rate (decimal). Use India 10Y govt bond yield as baseline.
SA_FA_WACC_RISK_FREE_RATE=0.07

# WACC — equity risk premium (decimal)
SA_FA_WACC_EQUITY_RISK_PREMIUM=0.06

# WACC — cost of debt (decimal)
SA_FA_WACC_COST_OF_DEBT=0.09

# WACC — tax rate (decimal). Indian corporate tax rate.
SA_FA_WACC_TAX_RATE=0.25

# WACC — default debt weight (decimal)
SA_FA_WACC_DEBT_WEIGHT=0.30

# WACC — default equity weight (decimal)
SA_FA_WACC_EQUITY_WEIGHT=0.70

# Budget variance materiality threshold (percentage)
SA_FA_VARIANCE_THRESHOLD_PCT=10.0

# Budget variance materiality threshold (amount in INR)
SA_FA_VARIANCE_THRESHOLD_AMT=5000000

# Forecast scenarios (comma-separated)
# Options: base | bull | bear (any combination)
SA_FA_FORECAST_SCENARIOS=base,bull,bear


# ------------------------------------------------------------
# Peer Comparison
# ------------------------------------------------------------

# Max number of peers to compare
SA_PEERS_MAX_COUNT=10

# Compare peers on fundamental ratios
# Options: true | false
SA_PEERS_FUNDAMENTAL_COMPARISON=true

# Compare peers on technical indicators
# Options: true | false
SA_PEERS_TECHNICAL_COMPARISON=true

# Peer fundamental metrics to compare (comma-separated)
# Options: pe | pb | roe | debt_to_equity | dividend_yield | market_cap | revenue_growth | net_margin | operating_margin | roa
SA_PEERS_FUNDAMENTAL_METRICS=pe,pb,roe,debt_to_equity,dividend_yield,market_cap,net_margin

# Peer technical metrics to compare (comma-separated)
# Options: rsi | ema_trend | macd_signal | price_vs_ema200 | 52w_high_pct | volume_trend
SA_PEERS_TECHNICAL_METRICS=rsi,ema_trend,macd_signal,price_vs_ema200


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Log level
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
SA_LOG_LEVEL=INFO

# Log file path (empty = stdout only)
SA_LOG_FILE=

# Log format
# Options: text | json
SA_LOG_FORMAT=text


# ------------------------------------------------------------
# HTTP / Network
# ------------------------------------------------------------

# User-Agent for web requests (screener.in, etc.)
SA_HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# HTTP request timeout (seconds) for yfinance and general requests
SA_HTTP_TIMEOUT=30

# Max retries for failed HTTP requests
SA_HTTP_MAX_RETRIES=3
